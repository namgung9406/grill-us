# Microsoft Entra SPA app registration. Do not add a client secret.
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
# Optional development API scope: api://{api-client-id}/Leaderboard.Access
VITE_ENTRA_API_SCOPE=
# Development-only feature flags. Production builds reject true values.
VITE_LEADERBOARD_ENABLED=false
VITE_E2E_AUTH=false

PORT=3001
NODE_ENV=development
# The leaderboard is development-only and creates SQLite only when enabled.
LEADERBOARD_ENABLED=false
# Use the API app tenant ID and Application ID URI when the leaderboard is enabled.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_REQUIRED_SCOPE=Leaderboard.Access
# Local development/test only. Production rejects this bypass.
LEADERBOARD_DEV_AUTH_BYPASS=false
LEADERBOARD_DEV_USER_ID=
LEADERBOARD_DEV_DISPLAY_NAME=
LEADERBOARD_RATE_LIMIT_MAX=5
# Stop the server before deleting this file and its -wal/-shm companions.
LEADERBOARD_DB_PATH=server/data/leaderboard.sqlite